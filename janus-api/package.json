{
  "name": "janus-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Janus local Windows service API for AI agent resources",
  "bin": {
    "janus": "./bin/janus.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts run",
    "build": "tsc --noEmit",
